# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=hanbridge
POSTGRES_PASSWORD=hanbridge_secret
POSTGRES_DB=hanbridge
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Backend (NestJS) ─────────────────────────────────────────
BACKEND_PORT=4000
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_refresh_secret_please
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend (Next.js) ───────────────────────────────────────
FRONTEND_PORT=3000
# When running through nginx use http://localhost/api
# When running backend directly use http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost/api

# ─── Nginx ────────────────────────────────────────────────────
NGINX_PORT=80

# ─── Integrations ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
