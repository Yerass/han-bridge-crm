// Han Bridge CRM — Prisma schema
// Full data model: auth/RBAC, students, teachers, groups, schedule,
// attendance, payments, finance, sales funnel, marketing, payroll, audit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMINISTRATOR
  ACCOUNTANT
  SALES_MANAGER
  TEACHER
  STUDENT
  PARENT
}

enum Language {
  CHINESE
  ENGLISH
}

enum StudyType {
  GROUP
  INDIVIDUAL
  INDIVIDUAL_ONLINE
}

enum StudentStatus {
  NEW
  TRIAL
  ACTIVE
  FROZEN
  GRADUATED
  DROPPED
}

enum LeadStage {
  NEW              // Новая заявка
  CONSULTATION     // Первичная консультация
  TRIAL_LESSON     // Пробный урок
  AWAITING_PAYMENT // Ожидание оплаты
  ACTIVE           // Активный студент
  GRADUATE         // Выпускник
  LOST             // Потерян
}

enum LeadSource {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  GOOGLE_ADS
  YANDEX
  OUTDOOR
  REFERRAL
  WALK_IN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  KASPI
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum FinanceCategory {
  // income
  STUDENT_PAYMENT
  INDIVIDUAL_LESSON
  MATERIALS_SALE
  OTHER_INCOME
  // expense
  TEACHER_SALARY
  STAFF_SALARY
  TARGETED_ADS
  SMM
  STATIONERY
  RENT
  UTILITIES
  INTERNET
  TAXES
  OTHER_EXPENSE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum TeacherPaymentType {
  PER_HOUR
  FIXED
  PER_STUDENT
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum MarketingChannel {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  GOOGLE_ADS
  YANDEX
  OUTDOOR
  OTHER
}

enum NotificationType {
  LESSON_REMINDER
  PAYMENT_REMINDER
  ABSENCE
  SUBSCRIPTION_END
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role      @default(ADMINISTRATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Optional links to domain profiles
  teacher Teacher?
  student Student?

  notes        Note[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
}

// ─────────────────────────────────────────────────────────────
// STUDENTS / PARENTS
// ─────────────────────────────────────────────────────────────

model Student {
  id            String        @id @default(cuid())
  fullName      String
  phone         String?
  email         String?
  birthDate     DateTime?
  language      Language      @default(CHINESE)
  level         String?       // HSK1..HSK6 or A1..C2
  studyType     StudyType     @default(GROUP)
  status        StudentStatus @default(NEW)
  averageGrade  Float?
  startDate     DateTime?
  notesText     String?

  // Optional user account (student portal)
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  parent   Parent? @relation(fields: [parentId], references: [id])
  parentId String?

  enrollments  GroupStudent[]
  payments     Payment[]
  attendances  Attendance[]
  documents    Document[]
  notes        Note[]
  lead         Lead?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([language])
}

model Parent {
  id        String    @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// TEACHERS
// ─────────────────────────────────────────────────────────────

model Teacher {
  id             String             @id @default(cuid())
  fullName       String
  phone          String?
  email          String?
  specialization String?            // e.g. "Китайский язык, HSK"
  languages      Language[]         @default([])
  hourlyRate     Decimal            @default(0) @db.Decimal(12, 2)
  paymentType    TeacherPaymentType @default(PER_HOUR)
  rating         Float?

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  groups       Group[]
  lessons      Lesson[]
  payrolls     Payroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// CLASSROOMS
// ─────────────────────────────────────────────────────────────

model Classroom {
  id            String          @id @default(cuid())
  name          String          @unique
  capacity      Int             @default(10)
  equipment     String?
  groups        Group[]
  scheduleSlots ScheduleSlot[]
  lessons       Lesson[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─────────────────────────────────────────────────────────────
// GROUPS (a 1-student INDIVIDUAL course is a Group of capacity 1)
// ─────────────────────────────────────────────────────────────

model Group {
  id           String    @id @default(cuid())
  name         String
  language     Language  @default(CHINESE)
  level        String?   // HSK2A, English B1, ...
  studyType    StudyType @default(GROUP)
  monthlyPrice Decimal   @default(0) @db.Decimal(12, 2) // стоимость обучения
  isActive     Boolean   @default(true)

  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId String?

  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?

  enrollments   GroupStudent[]
  scheduleSlots ScheduleSlot[]
  lessons       Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([language])
}

model GroupStudent {
  id        String   @id @default(cuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  isActive  Boolean  @default(true)

  @@unique([groupId, studentId])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────
// SCHEDULE (recurring weekly slots) + concrete LESSONS
// ─────────────────────────────────────────────────────────────

model ScheduleSlot {
  id         String     @id @default(cuid())
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  weekday    Int        // 1=Mon ... 7=Sun
  startTime  String     // "10:30"
  endTime    String     // "11:30"
  classroom  Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([weekday])
}

model Lesson {
  id          String       @id @default(cuid())
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  teacherId   String?
  classroom   Classroom?   @relation(fields: [classroomId], references: [id])
  classroomId String?

  date        DateTime
  startTime   String
  endTime     String
  durationMin Int          @default(60)
  status      LessonStatus @default(SCHEDULED)
  topic       String?
  notes       String?

  // teacher substitution support
  originalTeacherId String?

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([teacherId])
  @@index([date])
  @@index([status])
}

model Attendance {
  id        String           @id @default(cuid())
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    AttendanceStatus @default(PRESENT)
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(KASPI)
  status        PaymentStatus @default(PAID)
  paidAt        DateTime?
  periodStart   DateTime?     // абонемент: с
  periodEnd     DateTime?     // абонемент: по / следующая оплата
  comment       String?
  documentUrl   String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([paidAt])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    FinanceCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  comment     String?
  documentUrl String?

  // optional analytics links
  groupId    String?
  teacherId  String?
  studentId  String?
  campaignId String?
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])

  responsibleId String? // user id
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// PAYROLL (зарплатная ведомость)
// ─────────────────────────────────────────────────────────────

model Payroll {
  id          String        @id @default(cuid())
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  periodMonth Int           // 1..12
  periodYear  Int
  hoursWorked Decimal       @default(0) @db.Decimal(8, 2)
  hourlyRate  Decimal       @default(0) @db.Decimal(12, 2)
  baseAmount  Decimal       @default(0) @db.Decimal(12, 2)
  bonus       Decimal       @default(0) @db.Decimal(12, 2)
  penalty     Decimal       @default(0) @db.Decimal(12, 2)
  allowance   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
}

// ─────────────────────────────────────────────────────────────
// SALES FUNNEL (CRM продаж)
// ─────────────────────────────────────────────────────────────

model Lead {
  id           String     @id @default(cuid())
  fullName     String
  phone        String?
  email        String?
  language     Language   @default(CHINESE)
  stage        LeadStage  @default(NEW)
  source       LeadSource @default(OTHER)
  acquisitionCost Decimal @default(0) @db.Decimal(12, 2)
  comment      String?

  // sales manager (user)
  managerId String?

  // converted student
  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?  @unique

  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([source])
  @@index([managerId])
}

// ─────────────────────────────────────────────────────────────
// MARKETING
// ─────────────────────────────────────────────────────────────

model MarketingCampaign {
  id           String           @id @default(cuid())
  name         String
  channel      MarketingChannel @default(OTHER)
  budget       Decimal          @default(0) @db.Decimal(12, 2)
  startDate    DateTime
  endDate      DateTime?
  leadsCount   Int              @default(0)
  paidCount    Int              @default(0)
  revenue      Decimal          @default(0) @db.Decimal(12, 2)

  leads        Lead[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel])
}

// ─────────────────────────────────────────────────────────────
// SHARED: documents, notes, audit, notifications
// ─────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  name       String
  url        String
  mimeType   String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String?
  uploadedById String?
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  body      String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String?
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([leadId])
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String   // CREATE | UPDATE | DELETE
  entity     String   // model name
  entityId   String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  channel   String             @default("telegram")
  recipient String?            // chat id / phone
  payload   Json?
  message   String
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([type])
}
